---
interface Props {
  experience: { company: string; role: string; period: string; summary: string; proof: string }[];
  projects: { name: string; href: string; type: string; result: string }[];
  capabilityGroups: { label: string; items: string[] }[];
}
const { experience, projects, capabilityGroups } = Astro.props;
const data = { experience, projects, capabilityGroups };
---

<button class="terminal-launch" type="button" aria-haspopup="dialog" aria-controls="portfolio-terminal" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 5 6 6-6 6M13 18h7" /></svg>
  <span>Terminal</span>
</button>
<dialog id="portfolio-terminal" aria-labelledby="terminal-title" aria-describedby="terminal-description">
  <header class="terminal-bar">
    <div><h2 id="terminal-title">ratnadeep@portfolio</h2><p id="terminal-description">Explore my work from the command line.</p></div>
    <button class="terminal-close" type="button" aria-label="Close terminal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </header>
  <div class="terminal-scroll" tabindex="0" aria-label="Terminal output">
    <div class="terminal-output" role="log" aria-live="polite" aria-relevant="additions" aria-label="Command results"></div>
    <form class="terminal-form" autocomplete="off">
      <label for="terminal-command"><span class="terminal-user">visitor</span><span>:~$</span><span class="visually-hidden"> Portfolio command</span></label>
      <div class="terminal-input">
        <input id="terminal-command" name="command" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="300" enterkeyhint="send" aria-describedby="terminal-hints" />
        <span class="terminal-caret" aria-hidden="true" hidden></span>
      </div>
    </form>
  </div>
  <footer class="terminal-footer" id="terminal-hints"><span>Try <button type="button" data-command="help">help</button> or <button type="button" data-command="neofetch">neofetch</button></span><span>Tab completes · ↑ ↓ history · Esc closes</span></footer>
  <script is:inline type="application/json" id="terminal-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</dialog>

<script>
  type PortfolioData = {
    experience: { company: string; role: string; period: string; summary: string; proof: string }[];
    projects: { name: string; href: string; type: string; result: string }[];
    capabilityGroups: { label: string; items: string[] }[];
  };
  const dialog = document.querySelector<HTMLDialogElement>("#portfolio-terminal")!;
  const launch = document.querySelector<HTMLButtonElement>(".terminal-launch")!;
  const input = dialog.querySelector<HTMLInputElement>("#terminal-command")!;
  const output = dialog.querySelector<HTMLElement>(".terminal-output")!;
  const scroll = dialog.querySelector<HTMLElement>(".terminal-scroll")!;
  const caret = dialog.querySelector<HTMLElement>(".terminal-caret")!;
  const measure = document.createElement("canvas").getContext("2d")!;
  const updateCaret = () => requestAnimationFrame(() => {
    caret.hidden = document.activeElement !== input || input.selectionStart !== input.selectionEnd;
    if (caret.hidden) return;
    measure.font = getComputedStyle(input).font;
    const width = measure.measureText("M").width;
    const offset = measure.measureText(input.value.slice(0, input.selectionStart ?? 0)).width - input.scrollLeft;
    caret.style.width = `${width}px`;
    caret.style.left = `${Math.max(0, Math.min(offset, input.clientWidth - width))}px`;
  });
  ["input", "focus", "keyup", "click", "scroll", "select"].forEach(event => input.addEventListener(event, updateCaret));
  input.addEventListener("blur", () => { caret.hidden = true; });
  document.addEventListener("selectionchange", () => { if (dialog.open) updateCaret(); });
  window.addEventListener("resize", () => { if (dialog.open) updateCaret(); });
  const data: PortfolioData = JSON.parse(dialog.querySelector("#terminal-data")!.textContent!);
  const email = "ratnadeep.bhattacharyya@gmail.com";
  const resume = "/Ratnadeep%20Bhattacharyya%20Resume.pdf";
  const commands: Record<string, string> = {
    help: "List commands or help <command>", neofetch: "Show my profile at a glance",
    about: "Who I am and what I build", experience: "Roles and production results",
    projects: "Selected projects and repository links", skills: "Technical skills by area",
    contact: "Email, GitHub, and location", resume: "Get my resume",
    ls: "List portfolio files", cat: "Read a file: cat about.txt",
    pwd: "Show the current portfolio directory", open: "Jump to a section: open projects",
    history: "Show this session’s commands", clear: "Clear terminal output", exit: "Close the terminal"
  };
  const files: Record<string, string> = { "about.txt": "about", "experience.txt": "experience", "projects.txt": "projects", "skills.txt": "skills", "contact.txt": "contact", "resume.pdf": "resume" };
  const history: string[] = [];
  let cursor = 0;
  let draft = "";
  let previousOverflow = "";
  const bottom = () => { scroll.scrollTop = scroll.scrollHeight; };
  const write = (text: string, className = "") => {
    const line = document.createElement("pre");
    line.className = className;
    line.textContent = text;
    output.append(line);
    while (output.childElementCount > 100) output.firstElementChild?.remove();
    bottom();
    return line;
  };
  const link = (label: string, href: string) => {
    const line = document.createElement("div");
    const anchor = document.createElement("a");
    anchor.textContent = label;
    anchor.href = href;
    if (!href.startsWith("mailto:")) { anchor.target = "_blank"; anchor.rel = "noopener noreferrer"; }
    line.append(anchor);
    output.append(line);
    bottom();
  };
  const run = (raw: string) => {
    const args = raw.trim().split(/\s+/);
    const command = args.shift()?.toLowerCase() || "";
    const argument = args.join(" ").toLowerCase();
    if (!command) return;
    if (!Object.hasOwn(commands, command)) { write(`Command not found: ${command}. Type help to see portfolio commands.`, "terminal-error"); return; }
    if (argument && !["help", "cat", "open"].includes(command)) { write(`${command}: no arguments needed. Try help ${command}.`, "terminal-error"); return; }
    switch (command) {
      case "help":
        if (argument) write(Object.hasOwn(commands, argument) ? `${argument} — ${commands[argument]}` : `No command called “${argument}”. Type help.`, Object.hasOwn(commands, argument) ? "" : "terminal-error");
        else write(Object.entries(commands).map(([name, description]) => `${name.padEnd(12)}${description}`).join("\n"));
        break;
      case "neofetch": {
        const art = ["██████╗ ██████╗ ", "██╔══██╗██╔══██╗", "██████╔╝██████╔╝", "██╔══██╗██╔══██╗", "██║  ██║██████╔╝", "╚═╝  ╚═╝╚═════╝ "].join("\n");
        const profile = document.createElement("div");
        profile.className = "terminal-profile";
        const logo = document.createElement("pre"); logo.textContent = art; logo.setAttribute("aria-hidden", "true");
        const facts = document.createElement("pre"); facts.textContent = "Ratnadeep Bhattacharyya\n──────────────────────\nRole       Full-stack AI engineer\nExperience 8 years\nLocation   Bengaluru, India / Remote\nFocus      AI agents · RAG · platforms\nStack      Go · Python · TypeScript\nCurrently  Springboard";
        profile.append(logo, facts); output.append(profile); bottom();
        break;
      }
      case "about": write("I design agent workflows, product interfaces, distributed services, and cloud infrastructure that survive production.\n\n8 years shipping production systems. Based in Bengaluru, India; open to remote work."); break;
      case "experience": data.experience.forEach(job => write(`${job.company} — ${job.role}\n${job.period}\n${job.summary}\nResult: ${job.proof}`)); break;
      case "projects": data.projects.forEach(project => { write(`${project.name}\n${project.type}\n${project.result}`); link("View project → " + project.name, project.href); }); break;
      case "skills": data.capabilityGroups.forEach(group => write(`${group.label}\n${group.items.join(" · ")}`)); break;
      case "contact": write("Bengaluru, India / Remote\nInterested in senior full-stack AI, backend platform, and product engineering roles."); link(email, `mailto:${email}`); link("github.com/ratnadeep007", "https://github.com/ratnadeep007"); break;
      case "resume": link("Read / download Ratnadeep’s resume (PDF)", resume); break;
      case "ls": write(Object.keys(files).join("\n")); break;
      case "pwd": write("/home/visitor/ratnadeep-portfolio"); break;
      case "cat": Object.hasOwn(files, argument) ? run(files[argument]) : write(argument ? `File not found: ${argument}. Type ls to see portfolio files.` : "Usage: cat <file>. Type ls to see portfolio files.", "terminal-error"); break;
      case "open": {
        const sections: Record<string, string> = { about: "intro-title", experience: "work", projects: "projects", skills: "capabilities-title", contact: "contact" };
        const target = Object.hasOwn(sections, argument) ? sections[argument] : null;
        if (target) { dialog.close(); document.getElementById(target)?.scrollIntoView({ behavior: "instant", block: "start" }); }
        else write("Usage: open about | experience | projects | skills | contact", "terminal-error");
        break;
      }
      case "history": write(history.map((entry, i) => `${String(i + 1).padStart(3)}  ${entry}`).join("\n")); break;
      case "clear": output.replaceChildren(); break;
      case "exit": dialog.close(); break;
      default: write(`Command not found: ${command}. Type help to see portfolio commands.`, "terminal-error");
    }
    bottom();
  };
  const submit = (value: string) => {
    const command = value.trim();
    if (!command) return;
    history.push(command);
    if (history.length > 80) history.shift();
    cursor = history.length; draft = "";
    write(`visitor:~$ ${command}`, "terminal-echo");
    input.value = "";
    run(command);
    if (dialog.open) input.focus({ preventScroll: true });
    updateCaret();
  };
  write("Welcome to my portfolio terminal.\nType help for commands, or neofetch for a quick introduction.");
  launch.hidden = false;
  launch.addEventListener("click", () => {
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    dialog.showModal();
    input.focus({ preventScroll: true }); bottom();
  });
  dialog.querySelector(".terminal-close")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => { document.body.style.overflow = previousOverflow; launch.focus({ preventScroll: true }); });
  dialog.addEventListener("click", event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
  dialog.querySelector("form")!.addEventListener("submit", event => { event.preventDefault(); submit(input.value); });
  dialog.querySelectorAll<HTMLButtonElement>("[data-command]").forEach(button => button.addEventListener("click", () => submit(button.dataset.command!)));
  input.addEventListener("keydown", event => {
    if (event.key === "ArrowUp" || event.key === "ArrowDown") {
      event.preventDefault();
      if (cursor === history.length) draft = input.value;
      cursor = Math.max(0, Math.min(history.length, cursor + (event.key === "ArrowUp" ? -1 : 1)));
      input.value = cursor === history.length ? draft : history[cursor];
      input.setSelectionRange(input.value.length, input.value.length);
    } else if (event.key === "Tab" && !event.shiftKey && input.value.trim()) {
      const text = input.value.toLowerCase();
      const options = text.startsWith("cat ") ? Object.keys(files).map(file => `cat ${file}`) : text.startsWith("open ") ? ["about", "experience", "projects", "skills", "contact"].map(section => `open ${section}`) : Object.keys(commands);
      const matches = options.filter(option => option.startsWith(text));
      if (matches.length) { event.preventDefault(); if (matches.length === 1) input.value = matches[0]; else write(matches.join("  ")); }
    } else if (event.ctrlKey && event.key.toLowerCase() === "l") { event.preventDefault(); output.replaceChildren(); }
    else if (event.ctrlKey && event.key.toLowerCase() === "c" && input.selectionStart === input.selectionEnd) { event.preventDefault(); write(`visitor:~$ ${input.value} ^C`, "terminal-echo"); input.value = ""; }
  });
</script>

<style>
  .terminal-launch { display: inline-flex; align-items: center; gap: 7px; padding: 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: var(--type-caption); line-height: 1.5; cursor: pointer; min-height: 44px; }
  .terminal-launch[hidden] { display: none; }
  .terminal-launch:hover { color: var(--accent); }
  svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  dialog { width: min(880px, calc(100% - 32px)); max-width: none; height: min(620px, calc(100dvh - 48px)); max-height: none; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); color: var(--ink); overflow: hidden; }
  dialog[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: rgba(0, 0, 0, .65); }
  .terminal-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); background: var(--panel-raised); flex-shrink: 0; }
  .terminal-bar h2 { margin: 0; font: 600 .875rem/1.5 var(--mono); letter-spacing: 0; }
  .terminal-bar p { margin: 4px 0 0; color: var(--muted); font-size: .8125rem; line-height: 1.5; }
  .terminal-close { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: transparent; cursor: pointer; }
  .terminal-close:hover { color: var(--accent); border-color: var(--hover-line); }
  .terminal-scroll { flex: 1; min-height: 0; padding: 24px; overflow-y: auto; font: .875rem/1.75 var(--mono); }
  .terminal-output { display: grid; gap: 12px; }
  .terminal-output :global(pre) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; color: var(--supporting-ink); }
  .terminal-output :global(.terminal-echo) { color: var(--accent); margin-top: 12px; }
  .terminal-output :global(.terminal-error) { color: var(--ink); }
  .terminal-output :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .terminal-output :global(.terminal-profile) { display: flex; flex-wrap: wrap; gap: 24px; }
  .terminal-output :global(.terminal-profile pre:first-child) { color: var(--accent); }
  .terminal-form { display: flex; align-items: center; gap: 8px; margin-top: 20px; }
  .terminal-form label { flex-shrink: 0; color: var(--muted); }
  .terminal-user { color: var(--accent); }
  .terminal-input { position: relative; flex: 1; min-width: 0; }
  input { display: block; width: 100%; min-width: 0; padding: 8px 1ch 8px 0; border: 0; border-radius: 0; background: transparent; color: var(--ink); caret-color: transparent; font: inherit; }
  input:focus-visible { outline: none; }
  .terminal-caret { position: absolute; top: 50%; height: 1.2em; transform: translateY(-50%); background: var(--accent); opacity: .7; pointer-events: none; }
  .terminal-caret[hidden] { display: none; }
  .terminal-input:not(:focus-within) .terminal-caret { display: none; }
  @media (prefers-reduced-motion: no-preference) { .terminal-caret { animation: terminal-blink 1.1s steps(1, end) infinite; } }
  @keyframes terminal-blink { 0%, 55% { opacity: .7; } 56%, 100% { opacity: 0; } }
  .terminal-footer { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; min-height: 0; margin: 0; padding: 12px 20px; border-top: 1px solid var(--line); color: var(--muted); font: .75rem/1.6 var(--mono); flex-shrink: 0; }
  .terminal-footer button { background: none; border: 0; padding: 4px; color: var(--accent); font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (max-width: 700px) { dialog { height: calc(100dvh - 24px); width: calc(100% - 24px); } .terminal-scroll { padding: 18px 14px; } input { font-size: 1rem; } .terminal-bar, .terminal-footer { padding-inline: 14px; } .terminal-footer > span:last-child { display: none; } }
</style>

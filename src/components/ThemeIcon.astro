---
// Adapted from https://github.com/pqoqubbw/icons (lucide-animated).
// Sun and Moon use the original SVG paths and animation sequences.
// System uses Lucide's Monitor icon. See public/licenses/lucide-animated.txt.
interface Props {
  preference: "system" | "light" | "dark";
}

const { preference } = Astro.props;
const sunRays = [
  "M12 2v2", "m19.07 4.93-1.41 1.41", "M20 12h2", "m17.66 17.66 1.41 1.41",
  "M12 20v2", "m6.34 17.66-1.41 1.41", "M2 12h2", "m4.93 4.93 1.41 1.41"
];
---

<svg class={`theme-icon theme-icon-${preference}`} data-icon={preference} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {preference === "system" ? (
    <>
      <rect class="theme-monitor-screen" x="3" y="4" width="18" height="12" rx="2" pathLength="1" />
      <path class="theme-monitor-stand" d="M7 20h10M12 16v4" />
    </>
  ) : preference === "dark" ? (
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  ) : (
    <>
      <circle cx="12" cy="12" r="4" />
      {sunRays.map((d) => <path class="theme-icon-ray" d={d} />)}
    </>
  )}
</svg>

<script>
  const control = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let animations: Animation[] = [];
  const stop = () => {
    animations.forEach((animation) => animation.cancel());
    animations = [];
  };
  const animate = () => {
    stop();
    if (reduceMotion.matches || !control) return;
    const preference = document.documentElement.dataset.themePreference;
    const icon = control.querySelector<SVGElement>(`[data-icon="${preference}"]`);
    if (!icon) return;
    if (preference === "system") {
      const screen = icon.querySelector(".theme-monitor-screen");
      const stand = icon.querySelector(".theme-monitor-stand");
      if (screen) animations.push(screen.animate(
        [{ strokeDasharray: "1 1", strokeDashoffset: "1" }, { strokeDasharray: "1 1", strokeDashoffset: "0" }],
        { duration: 650, easing: "cubic-bezier(0.16, 1, 0.3, 1)" }
      ));
      if (stand) animations.push(stand.animate(
        [{ opacity: 0.4, transform: "translateY(2px)" }, { opacity: 1, transform: "translateY(0)" }],
        { duration: 400, delay: 160, easing: "cubic-bezier(0.16, 1, 0.3, 1)" }
      ));
    } else if (preference === "dark") {
      animations.push(icon.animate(
        [0, -10, 10, -5, 5, 0].map((angle) => ({ transform: `rotate(${angle}deg)` })),
        { duration: 1200, easing: "ease-in-out" }
      ));
    } else {
      icon.querySelectorAll(".theme-icon-ray").forEach((ray, index) => {
        animations.push(ray.animate([{ opacity: 0 }, { opacity: 1 }], {
          delay: (index + 1) * 100, duration: 300
        }));
      });
    }
  };
  control?.addEventListener("pointerenter", (event) => {
    if (event.pointerType === "mouse") animate();
  });
  control?.addEventListener("pointerleave", stop);
  control?.addEventListener("focus", () => {
    if (control.matches(":focus-visible")) animate();
  });
  control?.addEventListener("blur", stop);
  control?.addEventListener("click", () => requestAnimationFrame(animate));
  reduceMotion.addEventListener("change", stop);
</script>

<style>
  svg { transform-box: fill-box; transform-origin: center; }
</style>

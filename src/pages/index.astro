  .window-bar,
  .status-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 18px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .window-bar { border-bottom: 1px solid var(--line); }
  .window-bar span:last-child { color: var(--accent); }

  .system-window dl { margin: 0; padding: 12px 18px; }
  .system-window dl div { display: grid; grid-template-columns: 92px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .system-window dl div:last-child { border-bottom: 0; }
  .system-window dt { color: #718077; font-family: var(--mono); font-size: 0.72rem; text-transform: lowercase; }
  .system-window dd { margin: 0; color: #d8ded9; font-size: 0.9rem; line-height: 1.4; }
  .status-line { justify-content: flex-start; border-top: 1px solid var(--line); color: #bdc7bf; }
  .status-marker { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--accent); box-shadow: 0 0 14px rgba(185, 255, 102, 0.6); }

  .proof-rail {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
    background: rgba(17, 21, 18, 0.72);
  }

  .proof-rail div { min-height: 150px; display: grid; align-content: space-between; gap: 18px; padding: 28px clamp(24px, 4vw, 54px); border-right: 1px solid var(--line); }
  .proof-rail div:last-child { border-right: 0; }
  .proof-rail strong { color: var(--accent); font-family: var(--mono); font-size: clamp(2rem, 3vw, 3.4rem); letter-spacing: -0.065em; }
  .proof-rail span { max-width: 24ch; color: var(--muted); font-size: 0.88rem; line-height: 1.4; }

  .section { padding: 140px 0; }

  .thesis { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(54px, 9vw, 150px); }

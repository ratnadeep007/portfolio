    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const key = "portfolio-theme";
        const system = window.matchMedia("(prefers-color-scheme: dark)");
        const validPreference = (value) => value === "light" || value === "dark" ? value : "system";
        let preference = "system";
        try { preference = validPreference(localStorage.getItem(key)); } catch {}

        const applyTheme = () => {
          const theme = preference === "system" ? (system.matches ? "dark" : "light") : preference;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themePreference = preference;
          document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#0b0d0c" : "#e7e7df";
          const control = document.getElementById("theme-toggle");
          const next = preference === "system" ? "light" : preference === "light" ? "dark" : "system";
          const currentLabel = preference === "system" ? `System (${theme})` : preference;
          if (control) {
            control.setAttribute("aria-label", `Theme: ${currentLabel}. Switch to ${next} theme`);
            control.title = `Theme: ${currentLabel}. Switch to ${next} theme`;
          }
          const status = document.getElementById("theme-status");
          if (status) status.textContent = `Theme: ${currentLabel}`;
        };

        applyTheme();
        system.addEventListener("change", applyTheme);
        window.addEventListener("storage", (event) => {
          if (event.key === key || event.key === null) {
            preference = validPreference(event.newValue);
            applyTheme();
          }
        });
        document.addEventListener("DOMContentLoaded", () => {
          const control = document.getElementById("theme-toggle");
          control.disabled = false;
          applyTheme();
          control.addEventListener("click", () => {
            preference = preference === "system" ? "light" : preference === "light" ? "dark" : "system";
            try {
              if (preference === "system") localStorage.removeItem(key);
              else localStorage.setItem(key, preference);
            } catch {}
            applyTheme();
          });
        });
      })();
    </script>
  </head>
  <body>

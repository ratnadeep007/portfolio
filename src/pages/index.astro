        <span>Bengaluru, India / Remote</span>
        <a href="https://theskylab.in/">theskylab.in</a>
      </footer>
    </main>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const heroItems = [
        ".brand-lockup",
        ".navlinks",
        ".hero-copy .eyebrow",
        "#intro-title",
        ".lede",
        ".actions",
        ".system-window"
      ];
      const revealItems = gsap.utils.toArray<HTMLElement>("[data-reveal]");

      if (reduceMotion) {
        gsap.set([...heroItems, ...revealItems], { clearProps: "all", opacity: 1, y: 0 });
      } else {
        gsap.set(heroItems, { opacity: 0, y: 20 });
        gsap.set(".system-window", { opacity: 0, y: 24, rotate: 1.2 });
        gsap.set(revealItems, { opacity: 0, y: 22 });

        gsap
          .timeline({ defaults: { ease: "power3.out", duration: 0.72 } })
          .to(".brand-lockup", { opacity: 1, y: 0 }, 0)
          .to(".navlinks", { opacity: 1, y: 0 }, 0.05)
          .to(".hero-copy .eyebrow", { opacity: 1, y: 0 }, 0.12)
          .to("#intro-title", { opacity: 1, y: 0, duration: 0.92 }, 0.2)
          .to(".lede", { opacity: 1, y: 0 }, 0.34)
          .to(".actions", { opacity: 1, y: 0 }, 0.44)
          .to(".system-window", { opacity: 1, y: 0, rotate: 0, duration: 0.86 }, 0.38);

        revealItems.forEach((item) => {
          gsap.to(item, {
            opacity: 1,
            y: 0,
            duration: 0.62,
            ease: "power2.out",
            scrollTrigger: { trigger: item, start: "top 88%", once: true }
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f0f5ef;
    --muted: #9ca69f;
    --canvas: #0b0d0c;
    --panel: #111512;
    --panel-raised: #171c18;
    --line: #293029;
    --accent: #b9ff66;
    --accent-ink: #11180b;
    --max: 1280px;
    --radius: 18px;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --sans: "SF Pro Display", "Avenir Next", Avenir, "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-family: var(--sans);
  }

  * { box-sizing: border-box; }

  html {
    background: var(--canvas);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background:
      radial-gradient(circle at 76% 8%, rgba(185, 255, 102, 0.08), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      var(--canvas);
    background-size: auto, 56px 56px, 56px 56px, auto;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    content: "";
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
  }

  a { color: inherit; text-decoration: none; }
  p { text-wrap: pretty; }
  h1, h2, h3, p { margin-top: 0; }
  main { overflow: hidden; }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 20;
    padding: 10px 14px;
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-150%);
  }

  .skip-link:focus { transform: translateY(0); }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .hero,
  .section,
  .contact,
  footer {
    width: min(var(--max), calc(100% - 48px));
    margin-inline: auto;
  }

  .hero {
    min-height: 100dvh;
    padding: 24px 0 72px;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-lockup { display: inline-flex; align-items: center; gap: 13px; }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .brand-name {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .navlinks { display: flex; align-items: center; gap: 28px; }

  .navlinks a,
  .text-link {
    position: relative;
    padding-block: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
    transition: color 180ms ease;
  }

  .navlinks a::after,
  .text-link::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    content: "";
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .navlinks a:hover,
  .text-link:hover { color: var(--ink); }
  .navlinks a:hover::after,
  .text-link:hover::after { transform: scaleX(1); transform-origin: left; }

  .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, 0.72fr);
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
    padding-top: 54px;
  }

  .eyebrow {
    margin-bottom: 18px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 9.5ch;
    margin-bottom: 26px;
    font-size: clamp(4.2rem, 8.4vw, 8.4rem);
    font-weight: 620;
    line-height: 0.88;
    letter-spacing: -0.072em;
    text-wrap: balance;
  }

  h1 em { color: var(--accent); font-style: normal; font-weight: 620; }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2.7rem, 5.5vw, 6rem);
    font-weight: 570;
    line-height: 0.92;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  h3 {
    margin-bottom: 12px;
    font-size: clamp(1.45rem, 2.4vw, 2.15rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 590px;
    margin-bottom: 0;
    color: #c1c9c2;
    font-size: clamp(1.05rem, 1.65vw, 1.3rem);
    line-height: 1.55;
  }

  .actions,
  .contact-links { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 34px; }

  .button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 760;
    white-space: nowrap;
    transition: transform 180ms ease, background 180ms ease;
  }

  .button.primary { color: var(--accent-ink); background: var(--accent); }
  .button:hover { transform: translateY(-2px); background: #c7ff84; }
  .button:active { transform: translateY(1px); }

  .system-window {
    border: 1px solid #343d35;

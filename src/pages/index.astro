</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --ink: light-dark(#18251c, #f0f5ef);
    --muted: light-dark(#526357, #9ca69f);
    --canvas: light-dark(#e7e7df, #0b0d0c);
    --panel: light-dark(#efefe7, #111512);
    --panel-raised: light-dark(#dfe4d7, #171c18);
    --line: light-dark(#bbc5b5, #293029);
    --accent: light-dark(#35670d, #b9ff66);
    --accent-ink: light-dark(#f4f5ed, #11180b);
    --accent-hover: light-dark(#285109, #c7ff84);
    --supporting-ink: light-dark(#425448, #c1c9c2);
    --strong-ink: light-dark(#293b2d, #d8ded9);
    --diagram-surface: light-dark(#dce3d4, #0f1210);
    --diagram-line: light-dark(#a4b49d, #3d493f);
    --hover-line: light-dark(#71856a, #4a584c);
    --wash: light-dark(rgba(82, 124, 35, 0.05), rgba(185, 255, 102, 0.08));
    --diagram-wash: light-dark(rgba(82, 124, 35, 0.10), rgba(185, 255, 102, 0.12));
    --grid-line: light-dark(rgba(24, 37, 28, 0.035), rgba(255, 255, 255, 0.018));
    --shadow: light-dark(rgba(35, 57, 25, 0.08), rgba(0, 0, 0, 0.35));
    --max: 1280px;
    --radius: 16px;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --sans: "SF Pro Display", "Avenir Next", Avenir, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --type-display: clamp(2.75rem, 2.125rem + 4.25vw, 6rem);
    --type-section: clamp(2.5rem, 1.8rem + 3.2vw, 5.25rem);
    --type-title: clamp(1.5rem, 1.2rem + 0.7vw, 2rem);
    --type-subtitle: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
    --type-lead: clamp(1.125rem, 1rem + 0.25vw, 1.25rem);
    --type-statement: clamp(1.375rem, 1.1rem + 0.8vw, 1.875rem);
    --type-body: 1rem;
    --type-caption: 0.875rem;
    --type-technical: 0.8125rem;
    --leading-body: 1.65;
    --measure-prose: 62ch;
    --section-space: clamp(3.5rem, 6vw, 6rem);
    --group-space: clamp(2rem, 3vw, 3rem);
    --column-gap: clamp(2rem, 5vw, 5rem);
    font-family: var(--sans);
  }

  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }

  * { box-sizing: border-box; }

  html {
    background: var(--canvas);
    scroll-behavior: smooth;
    scroll-padding-top: 32px;
    scrollbar-color: var(--hover-line) var(--canvas);
    scrollbar-width: thin;
  }

  body {
    margin: 0;
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--ink);
    background:
      radial-gradient(circle at 76% 8%, var(--wash), transparent 26rem),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
      var(--canvas);
    background-size: auto, 56px 56px, 56px 56px, auto;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    content: "";
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
  }

  ::selection { color: var(--accent-ink); background: var(--accent); }
  a { color: inherit; text-decoration: none; text-underline-offset: 0.25em; }
  p { text-wrap: pretty; }
  h1, h2, h3, p { margin-top: 0; }
  main { overflow-x: clip; }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 20;
    padding: 10px 14px;
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-150%);
  }

  .skip-link:focus { transform: translateY(0); }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .hero,
  .section,
  .contact,
  footer {
    width: min(var(--max), calc(100% - 48px));
    margin-inline: auto;
  }

  .hero {
    min-height: min(44rem, 82svh);
    padding: 24px 0 var(--section-space);
    display: flex;
    flex-direction: column;
  }

  .topbar {
    min-height: 68px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
  }

  .brand-lockup { display: inline-flex; align-items: center; gap: 13px; }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--type-technical);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .brand-name {
    font-size: var(--type-caption);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .navlinks { display: flex; align-items: center; justify-content: flex-end; gap: 28px; }
  .theme-toggle { width: 44px; height: 44px; display: grid; place-items: center; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; transition: background 180ms ease, border-color 180ms ease, color 180ms ease; }
  .theme-toggle:is(:hover, :focus-visible) { border-color: var(--hover-line); background: var(--panel-raised); color: var(--accent); }
  .theme-toggle:active { background: var(--panel); }
  .theme-toggle:disabled { cursor: default; opacity: 0.6; }
  .theme-icon { width: 20px; height: 20px; display: none; }
  :root:not([data-theme-preference]) .theme-icon-system,
  :root[data-theme-preference="system"] .theme-icon-system,
  :root[data-theme-preference="light"] .theme-icon-light,
  :root[data-theme-preference="dark"] .theme-icon-dark { display: block; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  .navlinks a,
  .text-link {
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding-block: 10px;
    color: var(--muted);
    font-size: var(--type-caption);
    font-weight: 600;
    line-height: 1.4;
    transition: color 180ms ease;
  }

  .navlinks a::after,
  .text-link::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    content: "";
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  .navlinks a:is(:hover, :focus-visible),
  .text-link:is(:hover, :focus-visible) { color: var(--ink); }
  .navlinks a:is(:hover, :focus-visible)::after,
  .text-link:is(:hover, :focus-visible)::after { transform: scaleX(1); transform-origin: left; }

  .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, 0.72fr);
    gap: var(--column-gap);
    align-items: center;
    padding-top: var(--group-space);
  }

  .section-label {
    margin: 20px 0 24px;
    color: var(--accent);
    font-size: var(--type-technical);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 9.5ch;
    margin-bottom: 26px;
    font-size: var(--type-display);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1 em { color: var(--accent); font-style: normal; font-weight: inherit; }


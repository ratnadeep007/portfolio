    font-size: 1.08rem;
  }

  .proof {
    margin-bottom: 0;
    color: var(--ink) !important;
    font-weight: 800;
  }

  .projects {
    width: min(1280px, calc(100% - 40px));
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .project {
    min-height: 290px;
    padding: 28px;
    border: 1px solid rgba(16, 18, 20, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.74);
    box-shadow: 0 12px 46px rgba(39, 54, 45, 0.08);

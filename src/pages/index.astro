  }

  .project:hover {
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .project span {
    display: block;
    margin-bottom: 68px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project h3 {
    max-width: 12ch;
  }

  .project-1,
  .project-2 {
    grid-column: span 3;
  }

  .project-3,
  .project-4,
  .project-5 {
    grid-column: span 2;
  }

  .skill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-cloud span {
    padding: 12px 15px;
    border: 1px solid rgba(16, 18, 20, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.64);
    color: #30363a;
    font-weight: 750;
  }

  .contact {
    margin-bottom: 28px;
    padding: clamp(42px, 8vw, 86px);
    border-radius: 28px;
    background: #111512;
    color: #f5fbf2;
